# Local Compose values; Coolify generates and persists these magic variables.
SERVICE_PASSWORD_64_POSTGRES=replace-with-long-random-value
SERVICE_HEX_64_AUTH=replace-with-openssl-rand-hex-32
SERVICE_HEX_64_SETUP=replace-with-a-separate-openssl-rand-hex-32

POSTGRES_DB=init
POSTGRES_USER=init

# Public origin for the app.
BETTER_AUTH_URL=https://init.fs0ciety.org

# Existing public API; requests are proxied by authenticated Next.js routes.
RAIL_API_BASE_URL=https://reseau.fs0ciety.org
